# ==============================================================================
# QueryPilot Production Environment Template (.env.production.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production on your hosting provider (Render / Railway).
# 2. Populate real production values. Never commit real credentials to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Environment Configuration
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production
DEMO_MODE=true
BENCHMARK_ENABLED=false

# CORS Allowed Origins: Must match your Vercel frontend URL (comma-separated, NO WILDCARD '*')
# Example: https://querypilot.vercel.app,https://querypilot-demo.vercel.app
CORS_ORIGINS=https://your-querypilot-frontend.vercel.app

# ------------------------------------------------------------------------------
# 2. Database Connections (Neon Serverless PostgreSQL with SSL)
# ------------------------------------------------------------------------------
# NOTE: Replace [user], [pass], [host], and [endpoint-id] with your Neon credentials.
# Ensure 'sslmode=require' is present on all remote connections.

# App Database: Isolated ledger for query audit history, agent runs, and migrations
APP_DATABASE_URL=postgresql+psycopg://app_rw:YOUR_APP_RW_PASSWORD@ep-your-project.us-east-2.aws.neon.tech/querypilot_app?sslmode=require

# Shop Database (Read-Only): Dedicated untrusted role strictly restricted to SELECT
SHOP_DATABASE_URL=postgresql+psycopg://readonly_user:YOUR_READONLY_PASSWORD@ep-your-project.us-east-2.aws.neon.tech/sample_shop?sslmode=require

# Shop Database (Admin): Used strictly from your local machine to run migrations and seed data
SHOP_ADMIN_DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_NEON_OWNER_PASSWORD@ep-your-project.us-east-2.aws.neon.tech/sample_shop?sslmode=require

# ------------------------------------------------------------------------------
# 3. LLM Provider Credentials & Cost Safeguards
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY
# If using Google Gemini instead:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=AIzaSy...

# Public Demo Cost & Abuse Safeguards
DAILY_LLM_CALL_CAP=200
RATE_LIMIT_ASK_PER_MINUTE=5
RATE_LIMIT_AGENT_PER_MINUTE=3
LLM_MAX_OUTPUT_TOKENS=1000
AGENT_MAX_STEPS=4

