# ==========================================
# QueryPilot Environment Configuration
# ==========================================

# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_super_secret_change_me
POSTGRES_DB=postgres
POSTGRES_PORT=5436

# Database Role Passwords
APP_RW_PASSWORD=app_rw_secure_password_change_me
READONLY_PASSWORD=readonly_secure_password_change_me

# Backend Database URLs (Async psycopg 3 driver)
# Note: Using 127.0.0.1:5436 to connect directly to the Docker PostgreSQL container
APP_DATABASE_URL=postgresql+psycopg://app_rw:app_rw_secure_password_change_me@127.0.0.1:5436/querypilot_app
SHOP_DATABASE_URL=postgresql+psycopg://readonly_user:readonly_secure_password_change_me@127.0.0.1:5436/sample_shop

# Privileged Migration / Administration URL for sample_shop (runs as postgres superuser)
SHOP_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres_super_secret_change_me@127.0.0.1:5436/sample_shop

# Backend CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Frontend API Base URL
VITE_API_URL=http://127.0.0.1:8000

