# ==========================================
# QueryPilot Environment Configuration
# ==========================================

# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_super_secret_change_me
POSTGRES_DB=postgres
POSTGRES_PORT=5436

# Database Role Passwords
APP_RW_PASSWORD=app_rw_secure_password_change_me
READONLY_PASSWORD=readonly_secure_password_change_me

# Backend Database URLs (Async psycopg 3 driver)
# Note: Using 127.0.0.1:5436 to connect directly to the Docker PostgreSQL container
APP_DATABASE_URL=postgresql+psycopg://app_rw:app_rw_secure_password_change_me@127.0.0.1:5436/querypilot_app
SHOP_DATABASE_URL=postgresql+psycopg://readonly_user:readonly_secure_password_change_me@127.0.0.1:5436/sample_shop

# Privileged Migration / Administration URL for sample_shop (runs as postgres superuser)
SHOP_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres_super_secret_change_me@127.0.0.1:5436/sample_shop

# Backend CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Frontend API Base URL
VITE_API_URL=http://127.0.0.1:8000

# ==========================================
# LLM Provider Configuration (Phase 4)
# ==========================================
# Provider choice: 'openai' or 'fake' (for tests/offline demo)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.0

# Rate Limiting
RATE_LIMIT_ASK_PER_MINUTE=10

# ==========================================
# Agent Configuration (Phase 5)
# ==========================================
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=60.0
AGENT_SEND_ROW_PREVIEW=true
RATE_LIMIT_AGENT_PER_MINUTE=10

# ==========================================
# Query Optimizer & Benchmark (Phase 6)
# ==========================================
# Isolated benchmark copy database (sample_shop_bench)
BENCH_DATABASE_URL=postgresql+psycopg://readonly_user:readonly_secure_password_change_me@127.0.0.1:5436/sample_shop_bench
BENCH_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres_super_secret_change_me@127.0.0.1:5436/sample_shop_bench
RATE_LIMIT_OPTIMIZE_PER_MINUTE=5
BENCHMARK_DEFAULT_ITERATIONS=7
BENCHMARK_MAX_ITERATIONS=15
BENCHMARK_TIMEOUT_SECONDS=60.0


